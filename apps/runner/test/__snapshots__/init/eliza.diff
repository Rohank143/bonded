+// Added by `bonded-runner init`: Bonded's rating hook and Mandate Vault plugin. Edit it freely.
+// Guide: https://bonded-nu.vercel.app/docs/guides/bring-your-own-agent/
+import { bondedVaultFromEnv, isBondedEpisode } from "@bondedhq/sdk";
+import { bondedEpisodePlugin, bondedPlugin } from "@bondedhq/sdk/eliza";
+
+// While Bonded rates the agent, the production vault is never built, even if a .env file put its
+// variables back: rated trades go through the episode's tools only.
+const rated = isBondedEpisode();
+const vault = rated ? undefined : bondedVaultFromEnv();
+
+/**
+ * Bonded's plugin, for your agent's plugins:
+ * - while Bonded rates the agent: the episode's tools;
+ * - in production with BONDED_VAULT_ADDRESS set: BONDED_SWAP, BONDED_TRANSFER and BONDED_APPROVE
+ *   through your Mandate Vault (each dry-run first) and the BONDED_VAULT provider;
+ * - otherwise: nothing.
+ */
+export const bondedPlugins = rated
+  ? [bondedEpisodePlugin()]
+  : vault
+    ? [bondedPlugin({ vault })]
+    : [];

