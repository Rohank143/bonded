+// Added by `bonded-runner init`: a small server for Bonded's Agent URL. Edit it freely.
+// Guide: https://github.com/ddboy19912/bonded/blob/main/docs/BRING-YOUR-OWN-AGENT.md
+import { createServer } from "node:http";
+import { toNodeHandler } from "@bondedhq/sdk/agent-url";
+import { bondedHandler } from "./bonded-agent-url.js";
+
+const port = Number(process.env.BONDED_AGENT_PORT ?? 8787);
+createServer(toNodeHandler(bondedHandler)).listen(port, () =>
+  console.log(`Bonded Agent URL listening on http://localhost:${port}/`),
+);

# By hand
- Run src/bonded-server.ts next to your agent (it listens on BONDED_AGENT_PORT, default 8787) and put it behind HTTPS.
- Fill in onEpisode in src/bonded-agent-url.ts: run your agent on episode.task.goal with the episode's tools.

# Variables
BONDED_VAULT_ADDRESS, BONDED_AGENT_KEY, BONDED_ROUTER_ADDRESS, BONDED_AGENT_SECRET, BONDED_AGENT_PORT
