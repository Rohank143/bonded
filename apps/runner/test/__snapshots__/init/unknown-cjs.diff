--- /dev/null
+++ b/bonded.mjs
@@ -0,0 +1,14 @@
+// Added by `bonded-runner init`: Bonded's rating check and guarded Mandate Vault. Edit it freely.
+// Guide: https://github.com/ddboy19912/bonded/blob/main/docs/BRING-YOUR-OWN-AGENT.md
+import { bondedVaultFromEnv, guarded, isBondedEpisode } from "@bondedhq/sdk";
+
+/** True while Bonded rates the agent: use the episode's tools (BONDED_MCP_URL, BONDED_TOOLS_URL) then. */
+export const rated = isBondedEpisode();
+
+const vault = bondedVaultFromEnv();
+
+/**
+ * In production with BONDED_VAULT_ADDRESS set: your Mandate Vault, every write dry-run first and
+ * refused on a predicted breach. Trade with `await bondedVault.swap({ tokenIn, tokenOut, amountIn })`.
+ */
+export const bondedVault = vault ? guarded(vault) : undefined;

# By hand
- While Bonded rates your agent (`isBondedEpisode()`), read and trade through the episode's tools: the MCP server at BONDED_MCP_URL, or plain HTTP at BONDED_TOOLS_URL (see https://github.com/ddboy19912/bonded/blob/main/docs/BRING-YOUR-OWN-AGENT.md#use-your-framework).
- In production, send trades through `bondedVault` from the new file: `await bondedVault.swap({ tokenIn, tokenOut, amountIn })`.

# Variables
BONDED_VAULT_ADDRESS, BONDED_AGENT_KEY, BONDED_ROUTER_ADDRESS
# Adds
@bondedhq/sdk
