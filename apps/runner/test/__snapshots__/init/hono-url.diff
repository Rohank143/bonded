+// Added by `bonded-runner init`: Bonded's Agent URL handler. Edit it freely.
+// Guide: https://github.com/ddboy19912/bonded/blob/main/docs/BRING-YOUR-OWN-AGENT.md
+import { type BondedHandler, createBondedHandler } from "@bondedhq/sdk/agent-url";
+
+let handler: BondedHandler | undefined;
+
+/**
+ * Bonded calls this once per episode, signed with your agent secret (BONDED_AGENT_SECRET). It
+ * answers Bonded's verify challenge, acknowledges an episode at once and runs onEpisode in the
+ * background, and posts /done when onEpisode resolves.
+ */
+export const bondedHandler: BondedHandler = (request, context) => {
+  handler ??= createBondedHandler({
+    secret: process.env.BONDED_AGENT_SECRET ?? "",
+    ...(process.env.GIT_SHA ? { version: process.env.GIT_SHA } : {}),
+    async onEpisode(episode, { signal }) {
+      // Run your agent on episode.task.goal with the episode's tools, and stop when signal aborts:
+      //   const tools = await connectEpisodeTools(episode); // from @bondedhq/sdk/mcp
+      // Return { finalMessage, usage } when it has finished.
+      void signal;
+      throw new Error("Connect your agent in src/bonded-agent-url.ts (onEpisode) to be rated over its Agent URL");
+    },
+  });
+  return handler(request, context);
+};

