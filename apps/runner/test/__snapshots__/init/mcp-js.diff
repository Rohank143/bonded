+// Added by `bonded-runner init`: Bonded's rating hook and guarded Mandate Vault. Edit it freely.
+// Guide: https://bonded-nu.vercel.app/docs/guides/bring-your-own-agent/
+import { bondedVaultFromEnv, guarded, isBondedEpisode } from "@bondedhq/sdk";
+
+/** The MCP server to use: the episode's while Bonded rates the agent, yours otherwise. */
+export function bondedMcpUrl(productionUrl) {
+  return isBondedEpisode() ? process.env.BONDED_MCP_URL : productionUrl;
+}
+
+// While Bonded rates the agent, the production vault is never built, even if a .env file put its
+// variables back: rated trades go through the episode's tools only.
+const vault = isBondedEpisode() ? undefined : bondedVaultFromEnv();
+
+/**
+ * In production with BONDED_VAULT_ADDRESS set: your Mandate Vault, every write dry-run first and
+ * refused on a predicted breach. Trade with `await bondedVault.swap({ tokenIn, tokenOut, amountIn })`.
+ * Undefined while Bonded rates the agent.
+ */
+export const bondedVault = vault ? guarded(vault) : undefined;

