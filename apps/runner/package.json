{
  "name": "@bonded/runner",
  "version": "0.1.0",
  "description": "Connects an AI trading agent running on your own servers to the Bonded Arena, so it can be rated where it runs.",
  "license": "MIT",
  "keywords": [
    "bonded",
    "ai-agents",
    "runner",
    "mcp",
    "arena"
  ],
  "homepage": "https://github.com/ddboy19912/bonded/tree/main/apps/runner#readme",
  "bugs": {
    "url": "https://github.com/ddboy19912/bonded/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddboy19912/bonded.git",
    "directory": "apps/runner"
  },
  "type": "module",
  "bin": {
    "bonded-runner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test examples",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bonded/shared": "workspace:^",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/ws": "8.18.1"
  }
}
