---
import "@fontsource-variable/geist/index.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  /** "article" for a post, "website" for the index. */
  type?: "website" | "article";
  published?: Date;
  /** Absolute URL of the link-preview image. Defaults to the site's card. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  type = "website",
  published,
  ogImage = "https://www.bondedhq.xyz/brand/og.jpg",
  ogImageAlt = "Bonded: Don't cage your agent. Bond it.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const rss = new URL("rss.xml", new URL(base, Astro.site)).href;
// The blog is served under the web app's domain, so these are the app's own routes.
const site = {
  home: "/",
  how: "/#how",
  numbers: "/#numbers",
  docs: "/docs/",
  security: "/docs/security/policy/",
  app: "/overview",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Bonded blog" href={rss} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Bonded" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bonded_hq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>
    <!-- The same floating pill nav as the landing page (apps/web SiteLayout). -->
    <header class="site-header">
      <div class="pill">
        <a href={site.home} aria-label="Bonded home" class="logo">
          <img src={`${base}bonded-lockup.svg`} alt="Bonded" height="26" />
        </a>
        <nav aria-label="Site">
          <a href={site.numbers}>Live numbers</a>
          <a href={site.how}>How it works</a>
          <a href={site.docs}>Docs</a>
          <a href={base} aria-current={Astro.url.pathname.startsWith(base) ? "page" : undefined}>Blog</a>
        </nav>
        <a class="btn btn-light" href={site.app}>Launch app <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src={`${base}bonded-lockup.svg`} alt="Bonded" height="36" />
          <p>Don't cage your agent. Bond it. Running on Robinhood Chain testnet, with test tokens only.</p>
        </div>
        <div class="footer-links">
          <a href={site.docs}>Docs</a>
          <a href={site.security}>Security</a>
          <a href={base}>Blog</a>
          <a href={rss}>RSS</a>
          <a href="https://x.com/bonded_hq">X</a>
        </div>
      </div>
    </footer>
  </body>
</html>
