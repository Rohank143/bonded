---
import "@fontsource-variable/geist/index.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  /** "article" for a post, "website" for the index. */
  type?: "website" | "article";
  published?: Date;
}

const { title, description, type = "website", published } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
// Crawlers ignore relative image URLs, so this one is absolute.
const image = "https://www.bondedhq.xyz/brand/og.jpg";
const rss = new URL("rss.xml", new URL(import.meta.env.BASE_URL, Astro.site)).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Bonded blog" href={rss} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Bonded" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bonded_hq" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Bonded home">
        <svg viewBox="0 0 224 224" width="28" height="28" aria-hidden="true">
          <g fill="currentColor" transform="translate(12 6)">
            <path d="M7 0H130C159 0 182 23 182 51C182 75 170 90 149 101L112 121Q101 127 101 114V75Q101 49 73 61L7 90Q0 94 0 86V7Q0 0 7 0Z" />
            <path d="M0 130Q0 122 8 118L58 92Q77 82 77 101V137Q77 159 97 149L169 113Q175 110 180 117C193 129 200 143 200 158C200 190 172 212 136 212H6Q0 212 0 206Z" />
          </g>
        </svg>
        <span>Bonded</span>
      </a>
      <nav>
        <a href={import.meta.env.BASE_URL}>Blog</a>
        <a href="/docs/">Docs</a>
        <a class="cta" href="/agents/test">Test your agent</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Robinhood Chain testnet. Test tokens only; nothing here has real value.</span>
      <span><a href={rss}>RSS</a> · <a href="https://x.com/bonded_hq">@bonded_hq</a></span>
    </footer>
  </body>
</html>
