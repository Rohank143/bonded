---
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { indexPosts } from "../lib/sanity";

const [featured, ...rest] = await indexPosts();
---

<Base
  title="Blog | Bonded"
  description="Notes from Bonded on red-teaming AI agents, safety scores, and paying people back when an agent breaks its rules."
>
  <section class="hero">
    <p class="badge"><span class="dot" aria-hidden="true"></span>The Bonded blog</p>
    <h1>Notes from the <em>red team.</em></h1>
    <p class="lede">How AI agents get fooled, how we measure it, and who pays when one breaks its rules.</p>
  </section>

  <section class="list">
    {featured && <PostCard post={featured} featured />}
    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</Base>
