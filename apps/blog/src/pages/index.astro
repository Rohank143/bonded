---
import Base from "../layouts/Base.astro";
import { formatDate, publishedPosts } from "../posts";

const posts = await publishedPosts();
const base = import.meta.env.BASE_URL;
---

<Base
  title="Bonded blog"
  description="Notes from Bonded on red-teaming AI agents, safety scores, and paying people back when an agent breaks its rules."
>
  <div class="eyebrow">Blog</div>
  <h1>Notes from the red team</h1>
  <p class="lede">How AI agents get fooled, how we measure it, and who pays when one breaks its rules.</p>
  <ul class="posts">
    {
      posts.map((p) => (
        <li>
          <a href={`${base}${p.id}/`}>
            <div class="eyebrow">{formatDate(p.data.date)}</div>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
