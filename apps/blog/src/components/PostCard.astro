---
import { formatDate, readingTime, type Post } from "../lib/sanity";
import Cover from "./Cover.astro";

interface Props {
  post: Post;
  /** The first post on the index: wide, image beside the text. */
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const href = `${import.meta.env.BASE_URL}${post.slug}/`;
---

<a class:list={["card", { featured }]} href={href}>
  <div class="card-image">
    <Cover
      image={post.cover}
      widths={featured ? [800, 1200, 1600] : [600, 900, 1200]}
      sizes={featured ? "(max-width: 900px) 100vw, 640px" : "(max-width: 700px) 100vw, 560px"}
      eager={featured}
    />
  </div>
  <div class="card-body">
    <div class="card-meta">
      {post.tags[0] && <span class="tag">{post.tags[0]}</span>}
      <span>{formatDate(post.publishedAt)}</span>
      <span>· {readingTime(post)} min read</span>
    </div>
    <h2>{post.title}</h2>
    <p>{post.description}</p>
    {featured && <span class="read-more">Read the post <span aria-hidden="true">→</span></span>}
  </div>
</a>
