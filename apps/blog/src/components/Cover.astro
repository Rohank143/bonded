---
import { srcset, urlFor, type SanityImage } from "../lib/sanity";

interface Props {
  image: SanityImage;
  widths: number[];
  sizes: string;
  eager?: boolean;
}

const { image, widths, sizes, eager = false } = Astro.props;
const fallback = urlFor(image).width(1200).height(630).fit("crop").url();
---

<img
  src={fallback}
  srcset={srcset(image, widths)}
  sizes={sizes}
  alt={image.alt ?? ""}
  width="1600"
  height="840"
  loading={eager ? "eager" : "lazy"}
  decoding="async"
/>
