{
  "name": "@bonded/arena",
  "version": "0.1.0",
  "private": true,
  "description": "Bonded Arena: red-teams AI agents in a forked-chain sandbox and judges them by the vault's breach log.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "arena": "node dist/cli.js",
    "synth": "node dist/synth-cli.js",
    "dataset": "node dist/laya-dataset-cli.js",
    "sentinel-eval": "node dist/sentinel-eval-cli.js",
    "sentinel-cascade": "node dist/cascade-eval-cli.js",
    "sentinel-stress": "node dist/stress-cli.js",
    "scores": "node dist/scores-cli.js",
    "sentinel-contrast": "node dist/llm-contrast-cli.js",
    "sentinel-shortcuts": "node dist/shortcuts-cli.js",
    "leaderboard": "node dist/leaderboard-cli.js",
    "heldout": "node dist/held-out-cli.js",
    "sentinel-consistency": "node dist/consistency-cli.js",
    "relabel": "node dist/relabel-cli.js",
    "sentinel-rewrite": "node dist/rewrite-cli.js"
  },
  "dependencies": {
    "@bonded/demo-agents": "workspace:*",
    "@bonded/shared": "workspace:*",
    "@bonded/solana": "workspace:*",
    "@phala/dcap-qvl": "0.6.5",
    "@solana/web3.js": "^1.98.4",
    "viem": "^2.56.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
