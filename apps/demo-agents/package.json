{
  "name": "@bonded/demo-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Demo AI trading agents for the Bonded Arena: vulnerable-agent hardened-agent and a decision-model agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
