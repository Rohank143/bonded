# Bonded API (the Railway api service, or http://localhost:3000 for pnpm services).
VITE_API_URL=https://api-production-ba50.up.railway.app
# Optional: RPC for reads. Defaults to the public Robinhood Chain testnet RPC.
VITE_RPC_URL=
# Optional: enables WalletConnect QR/mobile wallets in RainbowKit.
# Browser wallets (Phantom, Rabby and EIP-6963 wallets such as MetaMask) work without it.
# Create a project at https://dashboard.reown.com and allow your deployed app's origin.
VITE_WALLETCONNECT_PROJECT_ID=
