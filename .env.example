# Copy this file to .env (git-ignored) and fill in only what you need:  cp .env.example .env
#
# You need NONE of this to build, run the tests, run the local demo, or run the Arena on a local
# chain. Those use anvil's public test accounts and never read .env.
#
# Rules:
# - Values already set in your shell win over this file.
# - Blank values are ignored, so leave anything you don't use empty.
# - Private keys are hex; the 0x prefix is added for you if it's missing.
# - Use testnet-only wallets. Never put a key that holds real funds here.

# ---------------------------------------------------------------------------------------------
# Deploying to a testnet (pnpm contracts:deploy robinhood | arbitrum)
# ---------------------------------------------------------------------------------------------

# Required. The deployer owns every contract and pays gas. Fund it from a testnet faucet.
DEPLOYER_PRIVATE_KEY=

# Optional. Addresses (not keys). Both default to the deployer's address.
ATTESTER=
COUNCIL=

# Optional. Seconds before new cover can claim. Defaults to 86400 (1 day); the live testnet
# deployments use 0 so the demo loop runs without waiting.
WAITING_PERIOD=

# ---------------------------------------------------------------------------------------------
# Running the demo loop against a testnet (pnpm contracts:smoke robinhood | arbitrum)
# ---------------------------------------------------------------------------------------------

# Optional. One key per role; each falls back to DEPLOYER_PRIVATE_KEY, so the deployer alone can
# play every role. Separate keys make the demo realistic (the agent key that gets frozen isn't
# the one that owns the vault). Each needs a little test ETH for gas.
OPERATOR_KEY=
AGENT_KEY=
USER_KEY=
ATTESTER_KEY=

# ---------------------------------------------------------------------------------------------
# Language models (only for --brain llm, --agent decision or --sentinel-model in the Arena)
# ---------------------------------------------------------------------------------------------

# An OpenRouter key reaches hundreds of models (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Or any other OpenAI-compatible endpoint, e.g. a local Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=

# Meta's models (muse-spark-1.3, muse-wonder-1.0, ...) go to Meta Model API with this key,
# whatever the settings above say (https://dev.meta.ai).
MODEL_API_KEY=

# ---------------------------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------------------------

# Optional. Runs the Arena's opt-in fork tests against this RPC (e.g. Robinhood testnet).
ARENA_FORK_URL=

# Day 7 services (each role migrates before starting).
DATABASE_URL=postgres://bonded:bonded@localhost:5432/bonded
ROLE=api
PORT=3000
RPC_URL=
DEPLOYMENT_FILE=contracts/evm/deployments/46630.json
KEEPER_KEY=
KEEPER_CONFIRMATIONS=5
# Bearer token (at least 24 characters) for POST requests.
API_TOKEN=
# JSON array of server-owned agent configs: kind, full mandate, codeHash.
AGENTS_FILE=
# Days of live events (SSE feed) to keep; the keeper role deletes older rows hourly.
EVENTS_RETENTION_DAYS=30
# Browser origins allowed to call the API (comma-separated), e.g. the web app's dev server.
WEB_ORIGINS=http://localhost:5173

# Sentinel: Laya-only by default. Cascade activation requires matching passing evidence.
SENTINEL_URL=
LAYA_API_KEY=
SENTINEL_MODEL_REPO=
SENTINEL_MODEL_REVISION=
SENTINEL_MODE=laya
SENTINEL_CASCADE_POLICY_FILE=
SENTINEL_CASCADE_EVALUATION_FILE=
