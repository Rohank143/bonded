{
  "name": "bonded",
  "private": true,
  "type": "module",
  "description": "Rate AI agents by attacking them, then insure the people who give them money.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:build": "cd contracts/evm && forge build",
    "contracts:test": "cd contracts/evm && forge test -vvv",
    "contracts:deploy": "contracts/evm/script/deploy.sh",
    "contracts:smoke": "contracts/evm/script/smoke.sh",
    "demo:local": "contracts/evm/script/local-demo.sh",
    "arena": "turbo run build --filter=@bonded/arena --output-logs=errors-only && pnpm --filter @bonded/arena arena",
    "services": "pnpm build && node apps/api/dist/main.js",
    "db:migrate": "pnpm build && ROLE=migrate node apps/api/dist/main.js",
    "test:services": "pnpm build && pnpm --filter @bonded/api test",
    "gate:local": "pnpm build && node apps/api/scripts/gate-1.mjs --local",
    "gate:testnet": "pnpm build && node apps/api/scripts/gate-1.mjs --broadcast",
    "sentinel:synth": "turbo run build --filter=@bonded/arena --output-logs=errors-only && pnpm --filter @bonded/arena synth",
    "sentinel:dataset": "turbo run build --filter=@bonded/arena --output-logs=errors-only && pnpm --filter @bonded/arena dataset",
    "solana:build": "cd contracts/solana && NO_DNA=1 anchor build --ignore-keys",
    "solana:test": "cd contracts/solana && NO_DNA=1 anchor build --ignore-keys && cargo test",
    "sentinel:eval": "turbo run build --filter=@bonded/arena --output-logs=errors-only && pnpm --filter @bonded/arena sentinel-eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "railway": "3.11.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
