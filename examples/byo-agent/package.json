{
  "name": "@bonded/example-byo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A small trading agent that runs on your own server and trades through a Bonded Mandate Vault with @bondedhq/sdk.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bondedhq/sdk": "workspace:*",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@bonded/sandbox": "workspace:*",
    "@bondedhq/shared": "workspace:*"
  }
}
