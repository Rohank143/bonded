{
  "name": "@bonded/shared",
  "version": "0.1.0",
  "description": "Bonded's shared schemas, ABIs, chain configs, signing types and the agent and runner protocols.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddboy19912/bonded.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "abis": "node scripts/gen-abis.mjs",
    "abis:check": "node scripts/gen-abis.mjs --check",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "viem": "^2.56.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
