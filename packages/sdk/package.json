{
  "name": "@bondedhq/sdk",
  "version": "0.1.1",
  "description": "Trade through a Bonded Mandate Vault and get rated by the Bonded Arena from any TypeScript agent: a typed vault client with dry runs, Sentinel checks and a mandate builder; the Arena episode's tools for LangChain, the Vercel AI SDK, ElizaOS and Coinbase AgentKit; and an Agent URL handler.",
  "license": "MIT",
  "keywords": [
    "bonded",
    "ai-agents",
    "mandate-vault",
    "mcp",
    "langchain",
    "langgraph",
    "vercel-ai-sdk",
    "agentkit",
    "solana-agent-kit",
    "elizaos",
    "viem"
  ],
  "homepage": "https://github.com/ddboy19912/bonded/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/ddboy19912/bonded/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddboy19912/bonded.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "bonded-mcp-config": "./dist/mcp-config-cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./agent-url": {
      "types": "./dist/agent-url.d.ts",
      "import": "./dist/agent-url.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./agentkit": {
      "types": "./dist/agentkit.d.ts",
      "import": "./dist/agentkit.js"
    },
    "./solana-agent-kit": {
      "types": "./dist/solana-agent-kit.d.ts",
      "import": "./dist/solana-agent-kit.js"
    },
    "./eliza": {
      "types": "./dist/eliza.d.ts",
      "import": "./dist/eliza.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eliza.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bondedhq/shared": "workspace:^",
    "@modelcontextprotocol/sdk": "1.30.1",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bonded/sandbox": "workspace:*",
    "@bondedhq/solana": "workspace:*",
    "@coinbase/agentkit": "0.10.4",
    "@elizaos/core": "1.7.2",
    "@langchain/core": "1.2.12",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "^1.98.4",
    "ai": "7.0.114",
    "solana-agent-kit": "2.0.10"
  },
  "peerDependencies": {
    "@bondedhq/solana": "workspace:^",
    "@coinbase/agentkit": "^0.10.4",
    "@elizaos/core": "^1.7.2",
    "@langchain/core": "^1.0.0",
    "@solana/web3.js": "^1.98.4",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "solana-agent-kit": "^2.0.10"
  },
  "peerDependenciesMeta": {
    "@bondedhq/solana": {
      "optional": true
    },
    "@coinbase/agentkit": {
      "optional": true
    },
    "@elizaos/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "solana-agent-kit": {
      "optional": true
    }
  }
}
