{
  "name": "@bonded/sdk",
  "version": "0.1.0",
  "description": "Trade through a Bonded Mandate Vault from any TypeScript agent: a typed vault client with dry runs, Sentinel checks, a mandate builder, and plugins for Coinbase AgentKit, Solana Agent Kit and ElizaOS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agentkit": {
      "types": "./dist/agentkit.d.ts",
      "import": "./dist/agentkit.js"
    },
    "./solana-agent-kit": {
      "types": "./dist/solana-agent-kit.d.ts",
      "import": "./dist/solana-agent-kit.js"
    },
    "./eliza": {
      "types": "./dist/eliza.d.ts",
      "import": "./dist/eliza.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddboy19912/bonded.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/ddboy19912/bonded/tree/main/packages/sdk#readme",
  "keywords": [
    "bonded",
    "ai-agents",
    "mandate-vault",
    "agentkit",
    "solana-agent-kit",
    "elizaos",
    "viem"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eliza.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@bonded/shared": "workspace:^",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bonded/sandbox": "workspace:*",
    "@bonded/solana": "workspace:*",
    "@coinbase/agentkit": "0.10.4",
    "@elizaos/core": "1.7.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "^1.98.4",
    "solana-agent-kit": "2.0.10"
  },
  "peerDependencies": {
    "@bonded/solana": "workspace:^",
    "@coinbase/agentkit": "^0.10.4",
    "@elizaos/core": "^1.7.2",
    "@solana/web3.js": "^1.98.4",
    "solana-agent-kit": "^2.0.10"
  },
  "peerDependenciesMeta": {
    "@bonded/solana": {
      "optional": true
    },
    "@coinbase/agentkit": {
      "optional": true
    },
    "@elizaos/core": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    },
    "solana-agent-kit": {
      "optional": true
    }
  }
}
