{
  "name": "@bondedhq/solana",
  "version": "0.1.2",
  "description": "TypeScript client for the Bonded Solana programs: IDLs, addresses, account decoding and instructions.",
  "license": "MIT",
  "keywords": [
    "bonded",
    "solana",
    "anchor",
    "mandate-vault"
  ],
  "homepage": "https://github.com/ddboy19912/bonded/tree/main/packages/solana#readme",
  "bugs": {
    "url": "https://github.com/ddboy19912/bonded/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddboy19912/bonded.git",
    "directory": "packages/solana"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "idls": "node scripts/gen-idls.mjs",
    "idls:check": "node scripts/gen-idls.mjs --check",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0"
  }
}
