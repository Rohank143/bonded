{
  "name": "@bonded/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Local chains for tests and the Arena: anvil with the Bonded protocol deployed by the production scripts, or a fork of a live chain.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@bonded/shared": "workspace:*",
    "viem": "^2.56.9"
  }
}
